    <!-- About. Keep the names of the app, people, projects and licences as they are -->
    <string name="shashinki_about_title">Camera %1$s</string>
    <string name="shashinki_about_privacy_title">Privacy</string>
    <string name="shashinki_about_privacy">Everything you photograph or record stays on this phone. The app has no internet access, so nothing is sent anywhere, and nothing is collected about you. It uses the camera to take pictures, the microphone only while a video is recording, and the phone\'s location only if you turn on \"Where a photo was taken\", when the place is written into each photo. Pictures and videos are saved under DCIM, where other apps on the phone can read them. A code you read is handed to another app only when you press its button; the picture kept for Wallet sits in the app\'s own cache. There are no ads, no analytics and no tracking.</string>
    <string name="shashinki_about_terms_title">Terms</string>
    <string name="shashinki_about_terms">This app is free software under the GNU General Public License v3 or later. It comes with no warranty: use it at your own risk.</string>
    <string name="shashinki_about_after">Open Camera by Mark Harman is the camera itself: everything here but its face.</string>
    <string name="shashinki_about_source">Source code: github.com/wanderwildwood/shashinki</string>
    <string name="shashinki_about_icons">Icons from Material Symbols, Apache 2.0</string>
