         joined so bright skies keep their detail; a third turns it off -->
    <string name="shashinki_hdr">Shadows</string>
    <string name="shashinki_hdr_plus">HDR</string>
    <!-- Joins several quick frames into one, for less grain in the dark -->
    <string name="shashinki_night">Night</string>
